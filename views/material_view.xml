<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>

        <record id="material_tree_view" model="ir.ui.view">
            <field name="name">solvitask.material.tree</field>
            <field name="model">solvitask.material</field>
            <field name="arch" type="xml">
                <tree string="Material" editable="bottom">
                    <field name="name"/>
                    <field name="unit"/>
                    <field name="unit_price"/>
                </tree>
            </field>
        </record>

        <record id="material_act_window" model="ir.actions.act_window">
            <field name="name">Materials</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">solvitask.material</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem name="Materials" id="material_menu" parent="solvitask_root" action="material_act_window" sequence="50"/>

    </data>
</odoo>
