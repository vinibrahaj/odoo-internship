<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>

        <record id="service_form_view" model="ir.ui.view">
            <field name="name">solvitask.service.form</field>
            <field name="model">solvitask.service</field>
            <field name="arch" type="xml">
                <form string="Service">
                    <sheet>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <field name="name" placeholder="Service name"/>
                            </h1>
                        </div>
                        <group>
                            <field name="unit_price"/>
                            <field name="default_tool_ids" widget="many2many_tags"/>
                        </group>
                        <group string="Description">
                            <field name="description" nolabel="1"/>
                        </group>
                        <group>
                            <field name="plumber_count"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="service_tree_view" model="ir.ui.view">
            <field name="name">solvitask.service.tree</field>
            <field name="model">solvitask.service</field>
            <field name="arch" type="xml">
                <tree string="Service">
                    <field name="name"/>
                    <field name="unit_price"/>
                </tree>
            </field>
        </record>

        <record id="service_act_window" model="ir.actions.act_window">
            <field name="name">Services</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">solvitask.service</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem name="Services" id="service_menu" parent="solvitask_root" action="service_act_window" sequence="30" groups="solvitask.group_solvitask_manager"/>

    </data>
</odoo>
