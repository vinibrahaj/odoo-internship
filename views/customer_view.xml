<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
        <record id="customer_form_view" model="ir.ui.view">
            <field name="name">solvitask.customer.form</field>
            <field name="model">solvitask.customer</field>
            <field name="arch" type="xml">
                <form string="Customer Details">
                    <sheet>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <field name="name" placeholder="Name"/>
                                <field name="surname" placeholder="Surname"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Contact Info">
                                <label for="phone"/>
                                <div class="o_row">
                                    <field name="phone" class="oe_inline"/>
                                    <button name="action_open_whatsapp" type="object" icon="fa-whatsapp" title="Message on WhatsApp" class="btn-link text-success" invisible="not phone"/>
                                </div>
                                <field name="email" widget="email"/>
                                <field name="address"/>
                                <field name="birthday" groups="solvitask.group_solvitask_manager,solvitask.group_solvitask_customer"/>
                            </group>
                            <group string="Account" groups="solvitask.group_solvitask_manager">
                                <field name="user_id"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Jobs">
                                <field name="job_ids">
                                    <tree>
                                        <field name="name"/>
                                        <field name="stage_id"/>
                                        <field name="total_price"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Requests">
                                <field name="request_ids">
                                    <tree>
                                        <field name="name"/>
                                        <field name="request_type"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="customer_tree_view" model="ir.ui.view">
            <field name="name">solvitask.customer.tree</field>
            <field name="model">solvitask.customer</field>
            <field name="arch" type="xml">
                <tree string="Customer">
                    <field name="name"/>
                    <field name="surname"/>
                    <field name="phone"/>
                    <button name="action_open_whatsapp" type="object" icon="fa-whatsapp" title="Message on WhatsApp" class="text-success"/>
                    <field name="email"/>
                </tree>
            </field>
        </record>

        <record id="customer_search_view" model="ir.ui.view">
            <field name="name">solvitask.customer.search</field>
            <field name="model">solvitask.customer</field>
            <field name="arch" type="xml">
                <search string="Customer">
                    <field name="name"/>
                    <field name="surname"/>
                    <field name="email"/>
                    <field name="phone"/>
                </search>
            </field>
        </record>

        <record id="customer_act_window" model="ir.actions.act_window">
            <field name="name">Customers</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">solvitask.customer</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem name="Customers" id="customer_menu" parent="solvitask_root" action="customer_act_window" sequence="10"/>

    </data>
</odoo>
