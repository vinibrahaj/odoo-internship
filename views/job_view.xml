<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>

        <!-- ==== RULE 4: drag-and-drop board, grouped by stage_id ==== -->
        <record id="job_kanban_view" model="ir.ui.view">
            <field name="name">solvitask.job.kanban</field>
            <field name="model">solvitask.job</field>
            <field name="arch" type="xml">
                <kanban default_group_by="stage_id" class="o_kanban_small_column" group_create="false" group_edit="false" groups_draggable="false" records_draggable="true">
                    <field name="stage_id"/>
                    <field name="plumber_ids"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_card oe_kanban_global_click">
                                <div class="oe_kanban_details">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <div><field name="customer_id"/></div>
                                    <div t-if="record.plumber_ids">
                                        <i class="fa fa-user" role="img" title="Assigned plumber"/>
                                        <field name="plumber_ids"/>
                                    </div>
                                    <div><field name="total_price"/></div>
                                    <field name="priority" widget="priority"/>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="job_form_view" model="ir.ui.view">
            <field name="name">solvitask.job.form</field>
            <field name="model">solvitask.job</field>
            <field name="arch" type="xml">
                <form string="Job">
                    <!--Available to every modifier; stage changes remain controlled server-side.--><field name="stage_id" invisible="1" readonly="1"/><header>
                        <button name="action_mark_started" string="Start Now" type="object" class="oe_highlight" groups="solvitask.group_solvitask_manager" invisible="stage_id not in ('stage_new')"/>
                        <button name="action_generate_invoice" string="Generate &amp; Send Invoice" type="object" class="oe_highlight" groups="solvitask.group_solvitask_manager" invisible="stage_id not in ('stage_ready_invoice', 'stage_invoiced', 'stage_paid')"/>
                        <button name="action_cancel" string="Cancel Job" type="object" class="btn-secondary" groups="solvitask.group_solvitask_manager" invisible="stage_id in ('stage_canceled', 'stage_paid')" confirm="Cancel this job?/>

                        <field name="stage_id" widget="statusbar" options="{'clickable': '1'}" groups="solvitask.group_solvitask_manager" statusbar_visible="stage_new,stage_in_progress,stage_ready_invoice,stage_invoiced,stage_paid"/>
                        <field name="stage_id" widget="statusbar" readonly="1" groups="solvitask.group_solvitask_customer" statusbar_visible="stage_new,stage_in_progress,stage_ready_invoice,stage_invoiced,stage_paid"/>
                        <field name="stage_id" widget="statusbar" readonly="1" groups="solvitask.group_solvitask_plumber" statusbar_visible="stage_new,stage_in_progress,stage_ready_invoice,stage_invoiced,stage_paid"/>
                    </header>
                    <sheet>
                        <widget name="web_ribbon" title="Canceled" bg_color="text-bg-danger" invisible="stage_id != 'stage_canceled'"/>
                        <widget name="web_ribbon" title="Paid" bg_color="text-bg-success" invisible="stage_id != 'stage_paid'"/>
                        <div class="oe_button_box" name="button_box">
                            <button type="object" name="action_view_requests" class="oe_stat_button" icon="fa-comments-o">
                                <field name="request_count" widget="statinfo" string="Requests"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <group>
                            <group string="Request">
                                <field name="customer_id"/>
                                <field name="title"/><field name="intake_request_id" readonly="1" groups="solvitask.group_solvitask_manager,solvitask.group_solvitask_customer" invisible="not intake_request_id"/><field name="is_custom"/>
                                <field name="service_id" invisible="is_custom"/>
                                <field name="priority"/>
                                <field name="description" required="is_custom" placeholder="Describe the problem"/>
                                <field name="problem_photo" widget="image"/>
                                <field name="building_type"/><field name="service_address"/>
                            </group>
                            <group string="Assignment">
                                <field name="plumber_ids" widget="many2many_tags" groups="solvitask.group_solvitask_plumber,solvitask.group_solvitask_manager"/>
                                <field name="customer_plumber_ids" widget="many2many_tags" readonly="1" groups="solvitask.group_solvitask_customer" invisible="not customer_plumber_ids"/>
                                <field name="started_date"/>
                                <field name="finished_date"/>
                                <field name="tool_ids" widget="many2many_tags"/>
                                <field name="last_request_update" readonly="1" invisible="not last_request_update"/>
                                <field name="last_request_update" readonly="1" invisible="not last_request_update"/>
                            </group>
                            <group string="Cancellation Details"
                                invisible="state != 'cancelled'">
                                <field name="cancel_reason" readonly="1"/>
                                <field name="cancel_details" readonly="1"/>
                                <field name="cancel_date" readonly="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Work Done" groups="solvitask.group_solvitask_plumber,solvitask.group_solvitask_manager">
                                <field name="material_line_ids">
                                    <tree editable="bottom">
                                        <field name="material_id"/>
                                        <field name="quantity"/>
                                        <field name="unit_price"/>
                                        <field name="subtotal"/>
                                    </tree>
                                </field>
                                <group class="oe_subtotal_footer">
                                    <field name="initial_price"/>
                                    <field name="hours_worked"/>
                                    <field name="labor_cost"/>
                                    <field name="material_cost"/>
                                    <field name="total_price"/>
                                </group>
                                <field name="work_notes" placeholder="What was found and fixed..."/>
                            </page>
                            <page string="Plumbers cost"
                                invisible="not is_custom or stage_id not in ('stage_ready_invoice', 'stage_invoiced', 'stage_paid')">
                                <group>
                                    <field name="plumber_line_ids"
                                        nolabel="1"
                                        readonly="1">

                                        <tree create="0" edit="0" delete="0">
                                            <field name="plumber_id"/>
                                            <field name="hours_worked"/>
                                            <field name="hourly_rate"/>
                                            <field name="subtotal" sum="Total Labor"/>
                                        </tree>

                                    </field>
                                </group>
                            </page>
                            <page string="Requests">
                                <field name="request_ids" context="{'default_job_id': id}">
                                    <tree editable="bottom">
                                        <field name="name"/>
                                        <field name="request_type"/>
                                        <field name="source"/>
                                        <field name="description"/>
                                        <field name="manager_note"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="job_tree_view" model="ir.ui.view">
            <field name="name">solvitask.job.tree</field>
            <field name="model">solvitask.job</field>
            <field name="arch" type="xml">
                <tree string="Job">
                    <field name="name"/>
                    <field name="customer_id"/>
                    <field name="is_custom" widget="boolean_toggle"/>
                    <field name="plumber_ids" groups="solvitask.group_solvitask_plumber,solvitask.group_solvitask_manager"/>
                    <field name="customer_plumber_ids" groups="solvitask.group_solvitask_customer" readonly="1"/>
                    <field name="priority"/>
                    <field name="stage_id"/>
                    <field name="total_price" sum="Total"/>
                </tree>
            </field>
        </record>

        <record id="job_search_view" model="ir.ui.view">
            <field name="name">solvitask.job.search</field>
            <field name="model">solvitask.job</field>
            <field name="arch" type="xml">
                <search string="Job">
                    <field name="name"/>
                    <field name="customer_id"/>
                    <field name="plumber_ids" groups="solvitask.group_solvitask_plumber,solvitask.group_solvitask_manager"/>
                    <filter string="Custom requests" name="filter_custom" domain="[('is_custom', '=', True)]"/>
                    <filter string="Listed services" name="filter_listed" domain="[('is_custom', '=', False)]"/>
                    <separator/>
                    <filter string="Unassigned" name="filter_unassigned" groups="solvitask.group_solvitask_plumber,solvitask.group_solvitask_manager" domain="[('plumber_ids', '=', False)]"/>
                    <filter string="Emergency" name="filter_emergency" domain="[('priority', '=', 'emergency')]"/>
                    <separator/>
                    <filter string="Open jobs" name="filter_open" domain="[('stage_id', 'not in',                                       ['stage_paid', 'stage_canceled'])]"/>
                    <filter string="Canceled" name="filter_canceled" domain="[('stage_id', '=', 'stage_canceled')]"/>
                    <group expand="0" string="Group By">
                        <filter string="Stage" name="group_by_stage" context="{'group_by': 'stage_id'}"/>
                        <filter string="Plumber" name="group_by_plumber" groups="solvitask.group_solvitask_plumber,solvitask.group_solvitask_manager" context="{'group_by': 'plumber_ids'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="job_act_window" model="ir.actions.act_window">
            <field name="name">Jobs</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">solvitask.job</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="context">{'default_stage_id': 'stage_new'}</field>
        </record>

        <menuitem name="Jobs" id="job_menu" parent="solvitask_root" action="job_act_window" sequence="5"/>

    </data>
</odoo>
