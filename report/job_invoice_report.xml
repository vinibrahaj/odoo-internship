<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The report action: also adds a "Print > Job Invoice" button on the job. -->
    <record id="action_report_job_invoice" model="ir.actions.report">
        <field name="name">Job Invoice</field>
        <field name="model">solvitask.job</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">solvitask.report_job_invoice</field>
        <field name="report_file">solvitask.report_job_invoice</field>
        <field name="binding_model_id" ref="model_solvitask_job"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_job_invoice">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Invoice</h2>
                        <div class="row mt-3">
                            <div class="col-6">
                                <strong>Job:</strong> <span t-field="doc.name"/><br/>
                                <strong>Date:</strong> <span t-field="doc.scheduled_date"/>
                            </div>
                            <div class="col-6">
                                <strong>Bill to:</strong><br/>
                                <span t-field="doc.customer_id.name"/><br/>
                                <span t-field="doc.customer_id.address"/><br/>
                                <span t-field="doc.customer_id.email"/>
                            </div>
                        </div>

                        <table class="table table-sm mt-4">
                            <thead>
                                <tr>
                                    <th>Material</th>
                                    <th class="text-end">Qty</th>
                                    <th class="text-end">Unit Price</th>
                                    <th class="text-end">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.material_line_ids" t-as="line">
                                    <td><span t-field="line.material_id"/></td>
                                    <td class="text-end"><span t-field="line.quantity"/></td>
                                    <td class="text-end"><span t-field="line.unit_price"/></td>
                                    <td class="text-end"><span t-field="line.subtotal"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="row">
                            <div class="col-5 offset-7">
                                <table class="table table-sm">
                                    <tr>
                                        <td>Initial Price</td>
                                        <td class="text-end"><span t-field="doc.initial_price"/></td>
                                    </tr>
                                    <tr>
                                        <td>Labor</td>
                                        <td class="text-end"><span t-field="doc.labor_cost"/></td>
                                    </tr>
                                    <tr>
                                        <td>Materials</td>
                                        <td class="text-end"><span t-field="doc.material_cost"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Total</strong></td>
                                        <td class="text-end">
                                            <strong><span t-field="doc.total_price"/></strong>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
